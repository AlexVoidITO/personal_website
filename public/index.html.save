<!DOCTYPE html>                                                                                                                                                                                                                                                                <html lang="ru">                                                                                                                                                                                                                                                               <head>                                                                                                                                                                                                                                                                             <meta charset="UTF-8" />                                                                                                                                                                                                                                                       <meta name="viewport" content="width=device-width, initial-scale=1.0" />                                                                                                                                                                                                       <title>Alex Void</title>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      <link rel="icon" href="/favicon.ico" />                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       <script src="https://cdn.tailwindcss.com"></script>                                                                                                                                                                                                                            <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet" />                                                                                                                                                                          <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />                                                                                                                                                              <script src="https://cdn.jsdelivr.net/npm/@iconify/iconify@1.0.7/dist/iconify.min.js"></script>                                                                                                                                                                                                                                                                                                                                                                                                                                                               <style>                                                                                                                                                                                                                                                                            * {                                                                                                                                                                                                                                                                                font-family: 'Press Start 2P', monospace !important;                                                                                                                                                                                                                           image-rendering: pixelated;                                                                                                                                                                                                                                                }                                                                                                                                                                                                                                                                              body {                                                                                                                                                                                                                                                                             background: #020205;                                                                                                                                                                                                                                                           background-image: radial-gradient(circle at 30% 40%, #0d0a1a, #000000);                                                                                                                                                                                                        min-height: 100vh;                                                                                                                                                                                                                                                             display: flex;                                                                                                                                                                                                                                                                 align-items: center;                                                                                                                                                                                                                                                           justify-content: center;                                                                                                                                                                                                                                                       padding: 1.5rem;                                                                                                                                                                                                                                                               margin: 0;                                                                                                                                                                                                                                                                 }                                                                                                                                                                                                                                                                              .pixel-card {                                                                                                                                                                                                                                                                      background: #0f0f1a;                                                                                                                                                                                                                                                           border: 3px solid #7c3aed;                                                                                                                                                                                                                                                     box-shadow: 0 0 0 2px #2d1b4e, 0 8px 0 0 #2d1b4e, inset 0 -4px 0 0 #2d1b4e;                                                                                                                                                                                                    image-rendering: pixelated;                                                                                                                                                                                                                                                    transition: all 0.15s steps(2);                                                                                                                                                                                                                                                width: 100%;                                                                                                                                                                                                                                                               }                                                                                                                                                                                                                                                                              .pixel-card:hover {                                                                                                                                                                                                                                                                border-color: #a855f7;                                                                                                                                                                                                                                                         box-shadow: 0 0 0 2px #3b2066, 0 8px 0 0 #3b2066, inset 0 -4px 0 0 #3b2066;                                                                                                                                                                                                    transform: translateY(-2px);                                                                                                                                                                                                                                               }                                                                                                                                                                                                                                                                              .pixel-btn {                                                                                                                                                                                                                                                                       background: #1a1028;                                                                                                                                                                                                                                                           border: 2px solid #7c3aed;                                                                                                                                                                                                                                                     box-shadow: 0 4px 0 0 #2d1b4e;                                                                                                                                                                                                                                                 transition: all 0.1s steps(2);                                                                                                                                                                                                                                                 color: #d8b4fe;                                                                                                                                                                                                                                                                font-size: 0.65rem;                                                                                                                                                                                                                                                            padding: 0.6rem 1rem;                                                                                                                                                                                                                                                          text-transform: uppercase;                                                                                                                                                                                                                                                     letter-spacing: 0.1em;                                                                                                                                                                                                                                                         cursor: pointer;                                                                                                                                                                                                                                                               text-decoration: none;                                                                                                                                                                                                                                                         display: inline-flex;                                                                                                                                                                                                                                                          align-items: center;                                                                                                                                                                                                                                                           gap: 0.5rem;                                                                                                                                                                                                                                                               }                                                                                                                                                                                                                                                                              .pixel-btn:hover {                                                                                                                                                                                                                                                                 background: #2d1b4e;                                                                                                                                                                                                                                                           border-color: #a855f7;                                                                                                                                                                                                                                                         box-shadow: 0 2px 0 0 #3b2066;                                                                                                                                                                                                                                                 transform: translateY(2px);                                                                                                                                                                                                                                                    color: #f0e6ff;                                                                                                                                                                                                                                                            }                                                                                                                                                                                                                                                                              .pixel-btn i {                                                                                                                                                                                                                                                                     color: #a855f7;                                                                                                                                                                                                                                                            }                                                                                                                                                                                                                                                                              .pixel-tag {                                                                                                                                                                                                                                                                       background: #1a1028;                                                                                                                                                                                                                                                           border: 2px solid #4c2b7a;                                                                                                                                                                                                                                                     color: #c4a0f0;                                                                                                                                                                                                                                                                padding: 0.5rem 0.8rem;                                                                                                                                                                                                                                                        font-size: 0.9rem;                                                                                                                                                                                                                                                             box-shadow: inset 0 -2px 0 0 #2d1b4e;                                                                                                                                                                                                                                          transition: all 0.25s ease;                                                                                                                                                                                                                                                    display: inline-flex;                                                                                                                                                                                                                                                          align-items: center;                                                                                                                                                                                                                                                           justify-content: center;                                                                                                                                                                                                                                                       min-width: 3.2rem;                                                                                                                                                                                                                                                             min-height: 3.2rem;                                                                                                                                                                                                                                                        }                                                                                                                                                                                                                                                                              .pixel-tag:hover {                                                                                                                                                                                                                                                                 background: #2d1b4e;                                                                                                                                                                                                                                                           border-color: #a855f7;                                                                                                                                                                                                                                                         transform: translateY(-3px) scale(1.05);                                                                                                                                                                                                                                       box-shadow: inset 0 -2px 0 0 #3b2066, 0 4px 0 0 #3b2066,                                                                                                                                                                                                                                   0 0 20px rgba(168, 85, 247, 0.5),                                                                                                                                                                                                                                              0 0 40px rgba(168, 85, 247, 0.3);                                                                                                                                                                                                                              }                                                                                                                                                                                                                                                                              .pixel-tag .iconify {                                                                                                                                                                                                                                                              font-size: 2rem;                                                                                                                                                                                                                                                               color: #a78bfa;                                                                                                                                                                                                                                                                transition: filter 0.25s ease;                                                                                                                                                                                                                                             }                                                                                                                                                                                                                                                                              .pixel-tag:hover .iconify {                                                                                                                                                                                                                                                        filter: drop-shadow(0 0 8px rgba(168, 85, 247, 0.8))                                                                                                                                                                                                                                   drop-shadow(0 0 20px rgba(168, 85, 247, 0.4));                                                                                                                                                                                                                     }                                                                                                                                                                                                                                                                              .pixel-contact {                                                                                                                                                                                                                                                                   border: 2px solid #2d1b4e;                                                                                                                                                                                                                                                     transition: all 0.1s steps(2);                                                                                                                                                                                                                                                 padding: 0.4rem 0.8rem;                                                                                                                                                                                                                                                        margin-bottom: 0.25rem;                                                                                                                                                                                                                                                        background: #0d0d18;                                                                                                                                                                                                                                                           display: flex;                                                                                                                                                                                                                                                                 align-items: center;                                                                                                                                                                                                                                                           gap: 0.75rem;                                                                                                                                                                                                                                                                  color: #c4a0f0;                                                                                                                                                                                                                                                                text-decoration: none;                                                                                                                                                                                                                                                         font-size: 0.65rem;                                                                                                                                                                                                                                                            word-break: break-word;                                                                                                                                                                                                                                                    }                                                                                                                                                                                                                                                                              .pixel-contact:hover {                                                                                                                                                                                                                                                             border-color: #a855f7;                                                                                                                                                                                                                                                         background: #1a1028;                                                                                                                                                                                                                                                           transform: translateX(4px);                                                                                                                                                                                                                                                }                                                                                                                                                                                                                                                                              .pixel-contact i {                                                                                                                                                                                                                                                                 color: #a855f7;                                                                                                                                                                                                                                                                width: 1.5rem;                                                                                                                                                                                                                                                                 text-align: center;                                                                                                                                                                                                                                                        }                                                                                                                                                                                                                                                                              .pixel-project:last-child {                                                                                                                                                                                                                                                        border-bottom: none;                                                                                                                                                                                                                                                       }                                                                                                                                                                                                                                                                              .pixel-project:hover {                                                                                                                                                                                                                                                             padding-left: 0.5rem;                                                                                                                                                                                                                                                          border-bottom-color: #a855f7;                                                                                                                                                                                                                                              }                                                                                                                                                                                                                                                                              .pixel-project .icon-box {                                                                                                                                                                                                                                                         background: #1a1028;                                                                                                                                                                                                                                                           border: 2px solid #4c2b7a;                                                                                                                                                                                                                                                     width: 2.5rem;                                                                                                                                                                                                                                                                 height: 2.5rem;                                                                                                                                                                                                                                                                display: flex;                                                                                                                                                                                                                                                                 align-items: center;                                                                                                                                                                                                                                                           justify-content: center;                                                                                                                                                                                                                                                       color: #a855f7;                                                                                                                                                                                                                                                                font-size: 1rem;                                                                                                                                                                                                                                                               flex-shrink: 0;                                                                                                                                                                                                                                                                box-shadow: inset 0 -2px 0 0 #2d1b4e;                                                                                                                                                                                                                                      }                                                                                                                                                                                                                                                                              .pixel-project .lang-tag {                                                                                                                                                                                                                                                         background: #1a1028;                                                                                                                                                                                                                                                           border: 1px solid #4c2b7a;                                                                                                                                                                                                                                                     color: #a78bfa;                                                                                                                                                                                                                                                                font-size: 0.45rem;                                                                                                                                                                                                                                                            padding: 0.15rem 0.6rem;                                                                                                                                                                                                                                                       letter-spacing: 0.05em;                                                                                                                                                                                                                                                        display: inline-block;                                                                                                                                                                                                                                                     }                                                                                                                                                                                                                                                                              .pixel-clock {                                                                                                                                                                                                                                                                     font-size: 2.5rem;                                                                                                                                                                                                                                                             color: #c4a0f0;                                                                                                                                                                                                                                                                text-shadow: 0 0 8px #7c3aed80, 0 0 20px #7c3aed40;                                                                                                                                                                                                                            letter-spacing: 0.2em;                                                                                                                                                                                                                                                     }                                                                                                                                                                                                                                                                              .pixel-lastfm {                                                                                                                                                                                                                                                                    background: #0d0d18;                                                                                                                                                                                                                                                           border: 2px solid #2d1b4e;                                                                                                                                                                                                                                                     padding: 0.8rem;                                                                                                                                                                                                                                                               box-shadow: inset 0 -2px 0 0 #2d1b4e;                                                                                                                                                                                                                                          display: flex;                                                                                                                                                                                                                                                                 align-items: center;                                                                                                                                                                                                                                                           gap: 1rem;                                                                                                                                                                                                                                                                     text-decoration: none !important;                                                                                                                                                                                                                                              color: inherit !important;                                                                                                                                                                                                                                                     transition: border-color 0.15s steps(2), background 0.15s steps(2);                                                                                                                                                                                                            flex-wrap: wrap;                                                                                                                                                                                                                                                           }                                                                                                                                                                                                                                                                              .pixel-lastfm:hover {                                                                                                                                                                                                                                                              border-color: #a855f7;                                                                                                                                                                                                                                                         background: #1a1028;                                                                                                                                                                                                                                                           transform: scale(1.005);                                                                                                                                                                                                                                                   }                                                                                                                                                                                                                                                                              .pixel-lastfm .cover {                                                                                                                                                                                                                                                             background: linear-gradient(145deg, #2d1b4e, #1a1028);                                                                                                                                                                                                                         border: 2px solid #4c2b7a;                                                                                                                                                                                                                                                     width: 3.5rem;                                                                                                                                                                                                                                                                 height: 3.5rem;                                                                                                                                                                                                                                                                display: flex;                                                                                                                                                                                                                                                                 align-items: center;                                                                                                                                                                                                                                                           justify-content: center;                                                                                                                                                                                                                                                       font-size: 1.5rem;                                                                                                                                                                                                                                                             color: #a855f7;                                                                                                                                                                                                                                                                overflow: hidden;                                                                                                                                                                                                                                                              flex-shrink: 0;                                                                                                                                                                                                                                                            }                                                                                                                                                                                                                                                                              .pixel-lastfm .cover img {                                                                                                                                                                                                                                                         width: 100%;                                                                                                                                                                                                                                                                   height: 100%;                                                                                                                                                                                                                                                                  object-fit: cover;                                                                                                                                                                                                                                                         }                                                                                                                                                                                                                                                                              .pixel-lastfm .track-name,                                                                                                                                                                                                                                                     .pixel-lastfm .artist-name {                                                                                                                                                                                                                                                       transition: color 0.15s steps(2);                                                                                                                                                                                                                                              max-width: 100%;                                                                                                                                                                                                                                                               overflow: hidden;                                                                                                                                                                                                                                                              text-overflow: ellipsis;                                                                                                                                                                                                                                                       white-space: nowrap;                                                                                                                                                                                                                                                       }                                                                                                                                                                                                                                                                              .pixel-lastfm .track-text-wrapper {                                                                                                                                                                                                                                                flex: 1 1 0;                                                                                                                                                                                                                                                                   min-width: 0;                                                                                                                                                                                                                                                                  max-width: 100%;                                                                                                                                                                                                                                                               overflow: hidden;                                                                                                                                                                                                                                                          }                                                                                                                                                                                                                                                                              .pixel-lastfm:hover .track-name {                                                                                                                                                                                                                                                  color: #d8b4fe;                                                                                                                                                                                                                                                            }                                                                                                                                                                                                                                                                              .pixel-lastfm:hover .artist-name {                                                                                                                                                                                                                                                 color: #c4a0f0;                                                                                                                                                                                                                                                            }                                                                                                                                                                                                                                                                              .play-btn {                                                                                                                                                                                                                                                                        background: #1a1028;                                                                                                                                                                                                                                                           border: 2px solid #4c2b7a;                                                                                                                                                                                                                                                     color: #a78bfa;                                                                                                                                                                                                                                                                padding: 0.3rem 0.6rem;                                                                                                                                                                                                                                                        font-size: 1.2rem;                                                                                                                                                                                                                                                             cursor: pointer;                                                                                                                                                                                                                                                               transition: all 0.15s steps(2);                                                                                                                                                                                                                                                display: inline-flex;                                                                                                                                                                                                                                                          align-items: center;                                                                                                                                                                                                                                                           justify-content: center;                                                                                                                                                                                                                                                       border-radius: 0;                                                                                                                                                                                                                                                              box-shadow: inset 0 -2px 0 0 #2d1b4e;                                                                                                                                                                                                                                          flex-shrink: 0;                                                                                                                                                                                                                                                            }                                                                                                                                                                                                                                                                              .play-btn:hover {                                                                                                                                                                                                                                                                  background: #2d1b4e;                                                                                                                                                                                                                                                           border-color: #a855f7;                                                                                                                                                                                                                                                         color: #f0e6ff;                                                                                                                                                                                                                                                                transform: translateY(-2px);                                                                                                                                                                                                                                                   box-shadow: inset 0 -2px 0 0 #3b2066, 0 4px 0 0 #3b2066,                                                                                                                                                                                                                                   0 0 15px rgba(168, 85, 247, 0.4);                                                                                                                                                                                                                              }                                                                                                                                                                                                                                                                              .play-btn:disabled {                                                                                                                                                                                                                                                               opacity: 0.4;                                                                                                                                                                                                                                                                  cursor: not-allowed;                                                                                                                                                                                                                                                           transform: none !important;                                                                                                                                                                                                                                                    box-shadow: none !important;                                                                                                                                                                                                                                               }                                                                                                                                                                                                                                                                              .pulse-dot {                                                                                                                                                                                                                                                                       display: inline-block;                                                                                                                                                                                                                                                         width: 8px;                                                                                                                                                                                                                                                                    height: 8px;                                                                                                                                                                                                                                                                   background: #a855f7;                                                                                                                                                                                                                                                           box-shadow: 0 0 8px #a855f7;                                                                                                                                                                                                                                                   animation: pulse 1.2s steps(2) infinite;                                                                                                                                                                                                                                   }                                                                                                                                                                                                                                                                              @keyframes pulse {                                                                                                                                                                                                                                                                 0%, 100% { opacity: 1; transform: scale(1); }                                                                                                                                                                                                                                  50% { opacity: 0.3; transform: scale(0.8); }                                                                                                                                                                                                                               }                                                                                                                                                                                                                                                                              ::-webkit-scrollbar {                                                                                                                                                                                                                                                              width: 10px;                                                                                                                                                                                                                                                                   background: #020205;                                                                                                                                                                                                                                                       }                                                                                                                                                                                                                                                                              ::-webkit-scrollbar-thumb {                                                                                                                                                                                                                                                        background: #2d1b4e;                                                                                                                                                                                                                                                           border: 2px solid #7c3aed;                                                                                                                                                                                                                                                 }                                                                                                                                                                                                                                                                              ::-webkit-scrollbar-thumb:hover {                                                                                                                                                                                                                                                  background: #4c2b7a;                                                                                                                                                                                                                                                       }                                                                                                                                                                                                                                                                              @keyframes pixelFade {                                                                                                                                                                                                                                                             0% { opacity: 0; transform: translateY(12px) scale(0.98); }                                                                                                                                                                                                                    100% { opacity: 1; transform: translateY(0) scale(1); }                                                                                                                                                                                                                    }                                                                                                                                                                                                                                                                              .pixel-fade {                                                                                                                                                                                                                                                                      animation: pixelFade 0.3s steps(3) forwards;                                                                                                                                                                                                                                   opacity: 0;                                                                                                                                                                                                                                                                }                                                                                                                                                                                                                                                                              .delay-1 { animation-delay: 0.05s; }                                                                                                                                                                                                                                           .delay-2 { animation-delay: 0.1s; }                                                                                                                                                                                                                                            .delay-3 { animation-delay: 0.15s; }                                                                                                                                                                                                                                           .delay-4 { animation-delay: 0.2s; }                                                                                                                                                                                                                                            .delay-5 { animation-delay: 0.25s; }                                                                                                                                                                                                                                           .delay-6 { animation-delay: 0.3s; }                                                                                                                                                                                                                                            .pixel-head {                                                                                                                                                                                                                                                                      font-size: 0.9rem;                                                                                                                                                                                                                                                             letter-spacing: 0.15em;                                                                                                                                                                                                                                                        color: #d8b4fe;                                                                                                                                                                                                                                                                text-shadow: 0 2px 0 #2d1b4e;                                                                                                                                                                                                                                              }                                                                                                                                                                                                                                                                              .pixel-head i {                                                                                                                                                                                                                                                                    color: #a855f7;                                                                                                                                                                                                                                                                margin-right: 0.5rem;                                                                                                                                                                                                                                                      }                                                                                                                                                                                                                                                                              .pixel-footer {                                                                                                                                                                                                                                                                    border-top: 3px solid #2d1b4e;                                                                                                                                                                                                                                                 padding: 1rem 0.5rem;                                                                                                                                                                                                                                                          margin-top: 2rem;                                                                                                                                                                                                                                                              font-size: 0.5rem;                                                                                                                                      
